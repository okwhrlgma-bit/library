# Streamlit Community Cloud secrets 템플릿 (Cycle 63·신경 0 배포)
#
# 사용법:
# 1. Streamlit Community Cloud (https://share.streamlit.io) 가입 (₩0)
# 2. New app → GitHub repo 연결 (okwhrlgma-bit/library)
# 3. Main file = src/kormarc_auto/ui/streamlit_app.py
# 4. Advanced settings → Secrets 박스에 본 파일 내용 붙여넣기 (값만 채우기)
# 5. Deploy = git push 시 자동 재배포
#
# 비용: ₩0·CPU 1·메모리 1GB·자동 sleep 후 재시작
# URL: kormarc-auto.streamlit.app (커스텀 가능)

# 외부 API 키 (없으면 demo mode 자동 활성)
NL_CERT_KEY = ""
DATA4LIBRARY_AUTH_KEY = ""
ALADIN_TTB_KEY = ""
KAKAO_API_KEY = ""
ANTHROPIC_API_KEY = ""

# Demo mode 강제 (키 0개로 작동)
KORMARC_DEMO_MODE = "1"
